# ==============================================================================
# IPO Intelligence Agent — Environment Configuration Template
# ==============================================================================

# Server Port
PORT=5050

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/finvibes_ipo

# WhatsApp Community / Announcement Group Invite Link
COMMUNITY_INVITE_LINK=https://chat.whatsapp.com/YOUR_COMMUNITY_LINK_HERE

# WhatsApp Automation Target (Group/Community JID - auto-detected or specified)
# e.g., 120363048923489234@g.us
WHATSAPP_TARGET_GROUP_JID=

# WhatsApp Session Storage Path
WHATSAPP_SESSION_DIR=./data/whatsapp_session

# Optional Cloud Gateway (if using MSG91 / Meta Cloud API instead of QR connection)
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=
